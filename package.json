{
  "name": "df12-lints",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "ISC",
  "files": [
    "dist",
    "docs/users-guide.md",
    "src",
    "tools/oxlint-plugin-df12"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxlint-plugin": "./tools/oxlint-plugin-df12/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "fmt": "bunx biome format --write .",
    "check:fmt": "bunx biome check --formatter-enabled=true --linter-enabled=false .",
    "lint": "bun run lint:biome && bun run lint:oxlint && bun run lint:markdown",
    "lint:biome": "bunx biome lint .",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:oxlint": "bunx oxlint .",
    "check:types": "tsc --noEmit",
    "test": "bun test",
    "test:all": "bun run check:fmt && bun run check:types && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "bun-types": "^1.1.3",
    "fast-check": "^4.3.0",
    "markdownlint-cli2": "^0.22.1",
    "oxlint": "^1.66.0",
    "typescript": "^5.6.3"
  }
}
